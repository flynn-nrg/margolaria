<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info.plist: the app's metadata, read by macOS (Finder, Launch Services, the
  Dock). Values written as $(NAME) are filled in from build settings at build
  time; most of them come from Config/Base.xcconfig.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<!--
	  What macOS shows when Margolaria first touches ~/Documents (M4c2): its
	  folder there holds the user's libraries and materials. macOS asks
	  even for apps outside the sandbox.
	-->
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Margolaria keeps your node libraries and materials in Documents › Margolaria.</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.graphics-design</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Miguel Mendez. MIT License.</string>

	<!--
	  Document types this app can open. "Editor" means we can open and save
	  them. LSItemContentTypes refers to the type declared below by its
	  identifier, not by file extension. The same identifier is passed to
	  MaterialXDocument as `typeName`.
	-->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>MaterialX Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>io.aswf.materialx</string>
			</array>
			<!--
			  The NSDocument subclass that opens this type. Swift classes
			  are registered with the Objective-C runtime under their module
			  name, so it is "Margolaria.MaterialXDocument".
			-->
			<key>NSDocumentClass</key>
			<string>$(PRODUCT_MODULE_NAME).MaterialXDocument</string>
		</dict>
	</array>

	<!--
	  Teaches macOS what a .mtlx file is: a Uniform Type Identifier (UTI).
	  It's "imported" rather than "exported" because we don't own the format;
	  MaterialX does.

	  macOS 27 declares this type itself ("MaterialX Shader Document", in
	  CoreTypes), and a system declaration wins over any app's. We use the
	  same identifier and conformances, so this entry only matters on older
	  macOS versions that don't know the type. (Until M1a we used our own
	  identifier, org.materialx.mtlx; macOS 27 then labelled .mtlx files with
	  its type, and NSDocumentController refused to open them.)
	-->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.aswf.materialx</string>
			<key>UTTypeDescription</key>
			<string>MaterialX Document</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.3d-content</string>
				<string>public.xml</string>
			</array>
			<key>UTTypeReferenceURL</key>
			<string>https://materialx.org</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mtlx</string>
				</array>
			</dict>
		</dict>
	</array>

	<!--
	  A type of our own, which we do own, so it is "exported": a node
	  dragged from the Library tab to the canvas (M2e, LibraryPanel.swift).
	  Only Margolaria reads it; declaring it keeps the drag from being
	  offered to other apps as text.
	-->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>eu.emerald-isle.margolaria.nodedef</string>
			<key>UTTypeDescription</key>
			<string>MaterialX Node Definition</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
