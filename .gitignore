# --- Generated Xcode project ----------------------------------------------
# project.yml is the source of truth; run `xcodegen` to (re)create the
# .xcodeproj. Never edit the generated project by hand.
/Margolaria.xcodeproj/

# --- Build products ------------------------------------------------------
/build/
DerivedData/
# SwiftPM's build directory, for local packages built with `swift build`.
.build/
.swiftpm/

# --- Third-party code fetched by scripts ---------------------------------
# apple/SwiftUsd, cloned and patched by scripts/fetch-swiftusd.sh. The patch
# itself (Vendor/*.patch) is tracked.
/Vendor/SwiftUsd/
# OpenColorIO, built as an xcframework by scripts/build-ocio.sh.
/Vendor/OpenColorIO/
# MaterialX's example materials, fetched by scripts/fetch-materialx-examples.sh.
/Vendor/MaterialX/
# OSL's tools (oslc, testshade, testrender), built by scripts/build-osl.sh.
/Vendor/OSL/
# MaterialX's OSL generators, built as an xcframework by scripts/build-materialx-genosl.sh.
/Vendor/MaterialXGenOsl/

# --- Local, per-developer settings ---------------------------------------
# Holds DEVELOPMENT_TEAM and CODE_SIGN_IDENTITY (see Config/Signing.local.xcconfig.example).
/Config/Signing.local.xcconfig
xcuserdata/
*.xcuserstate

