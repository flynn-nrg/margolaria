<?xml version="1.0"?>
<!--
  margolaria_cmlib.mtlx: colour transforms to ACEScg (M5d).

  MaterialX's cmlib converts every colour space it names to lin_rec709 only,
  so a shader generated to compute in ACEScg (an exported shader, when the
  document's working space is acescg) found no transform for its sRGB
  textures and Rec.709 values. These are the missing ones, built as cmlib's
  own are: <space>_to_lin_rec709, then lin_rec709 to ACEScg by the exact
  inverse of cmlib's acescg_to_lin_rec709 matrix (transposed, as MaterialX
  multiplies row vectors), so a round trip changes nothing.

  Loaded only for shader generation's colour management, not into the
  node library (MXBridge.cpp, Library::loadStandard). Compiled to .oso for
  OSL networks with MaterialX's library by scripts/build-materialx-genosl.sh,
  which also copies this file into the framework, where it is read from.
-->
<materialx version="1.39">
  <nodedef name="ND_lin_rec709_to_acescg_color3" node="lin_rec709_to_acescg" nodegroup="colortransform">
    <input name="in" type="color3" value="0, 0, 0" />
    <output name="out" type="color3" />
  </nodedef>
  <nodedef name="ND_lin_rec709_to_acescg_color4" node="lin_rec709_to_acescg" nodegroup="colortransform">
    <input name="in" type="color4" value="0, 0, 0, 0" />
    <output name="out" type="color4" />
  </nodedef>
  <nodedef name="ND_adobergb_to_acescg_color3" node="adobergb_to_acescg" nodegroup="colortransform">
    <input name="in" type="color3" value="0, 0, 0" />
    <output name="out" type="color3" />
  </nodedef>
  <nodedef name="ND_adobergb_to_acescg_color4" node="adobergb_to_acescg" nodegroup="colortransform">
    <input name="in" type="color4" value="0, 0, 0, 0" />
    <output name="out" type="color4" />
  </nodedef>
  <nodedef name="ND_g18_rec709_to_acescg_color3" node="g18_rec709_to_acescg" nodegroup="colortransform">
    <input name="in" type="color3" value="0, 0, 0" />
    <output name="out" type="color3" />
  </nodedef>
  <nodedef name="ND_g18_rec709_to_acescg_color4" node="g18_rec709_to_acescg" nodegroup="colortransform">
